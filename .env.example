# JobView Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=postgres  # Use 'postgres' for Docker, '127.0.0.1' for local
DB_PORT=5432      # Use 5432 for Docker, 5433 for local
DB_USER=jobview   # Production user
DB_PASSWORD=iutaol123
DB_NAME=jobview_db
DB_SSLMODE=disable

# Server Configuration
SERVER_PORT=8010
PORT=8010
ENVIRONMENT=production

# JWT Configuration (CRITICAL: Change in production!)
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTc1NzY3MzQxOSwiZXhwIjoxNzg4Nzc3NDE5fQ.SxEbI31tzB1UOVJqNybN1yFi1VH0VjoQxFE6n9dIo7c
JWT_ACCESS_DURATION=2h
JWT_REFRESH_DURATION=168h

# API Configuration
VITE_API_BASE=/api

# Production Domain
DOMAIN=jobview.bfsmlt.top

# Database Connection Pool (Production Optimization)
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600

# Performance Settings
ENABLE_GZIP=true
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m

