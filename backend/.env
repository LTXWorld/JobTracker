# JobView Backend Environment Variables

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=ltx
DB_PASSWORD=iutaol123
DB_NAME=jobView_db
DB_SSLMODE=disable

# Server Configuration
SERVER_PORT=8010
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET=your_256_bit_jwt_secret_key_change_in_production_must_be_32_chars_minimum
JWT_ACCESS_DURATION=24h
JWT_REFRESH_DURATION=720h

# Mail Integration (defaults，可按需覆盖)
MAIL_ENCRYPTION_KEY=kpsb-mail-encryption-placeholder
MAIL_POLLING_ENABLED=false
MAIL_POLLING_WORK_HOURS=0 0 12-19 * * *
MAIL_POLLING_OFF_HOURS=0 0 7,22 * * *
# QQ Mail IMAP configuration
MAIL_PROTOCOL=imap
MAIL_IMAP_HOST=imap.qq.com
MAIL_IMAP_PORT=993
MAIL_USE_TLS=true
MAIL_SYNC_CRON=0 */5 * * * *
